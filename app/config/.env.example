APP_NAME=BARET
APP_ENV=production
APP_DEBUG=false
# Kosongkan bila situs dipasang di root domain; isi bila perlu URL absolut (email reset sandi, QR).
APP_URL=https://baret.or.id
# Diisi otomatis oleh `php database/install.php`. JANGAN diubah setelah ada data (dipakai enkripsi NIK).
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=baret
DB_USERNAME=root
DB_PASSWORD=

MAIL_DRIVER=log
MAIL_FROM=noreply@baret.or.id
MAIL_FROM_NAME=BARET
